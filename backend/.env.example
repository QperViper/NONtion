# nontion guarda todo en backend/data/local_db.json: funciona sin este archivo y sin internet.
# Para sincronizar entre equipos (torre y notebook), completa estas dos líneas con los datos de tu proyecto:
# Supabase → Project Settings → API (URL) y API Keys → Secret key (sb_secret_…). La clave pública (anon)
# no sirve: las tablas tienen RLS activo sin políticas, solo la clave secreta puede leerlas.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=nontion-assets

# Opcional
# PORT=4000
# NONTION_DATA_DIR=C:\nontion-datos       (sacar los datos de una carpeta sincronizada por OneDrive)
# NONTION_SYNC_DEBOUNCE_MS=4000           (espera tras la última escritura antes de sincronizar)
# NONTION_SYNC_INTERVAL_MS=60000          (sincronización periódica para traer cambios de otros equipos)
# NONTION_TRASH_DAYS=30
# NONTION_BROWSER=C:\ruta\al\navegador.exe

# Ya no se usan (PostgreSQL retirado): DATABASE_URL, LOCAL_DATABASE_URL, DATABASE_SSL, DATABASE_SSL_CA
