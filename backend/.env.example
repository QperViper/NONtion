# Copia este archivo como .env (no se sube a Git) y completa tus datos.

# Base de datos. Con Supabase: botón "Connect" → "Session pooler" → URI, con tu contraseña en lugar de [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/NONtion
PORT=4000

# Solo en el equipo que tenía la base local, para "Pasar a Supabase.cmd": la dirección de esa base local.
# LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/NONtion

# Imágenes en Supabase Storage (Project Settings → API Keys → clave secreta "sb_secret_…").
# Sin estas dos líneas, las imágenes quedan solo en este equipo.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=nontion-assets

# Opcional: verificar el certificado de Supabase (Database Settings → SSL → descargar) guardado en backend/.
# DATABASE_SSL_CA=prod-ca-2021.crt

# Opcional: navegador para la ventana de la app (por defecto Brave, Chrome o Edge)
# NONTION_BROWSER=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
