{
  "name": "nontion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "serve": "node --import ./backend/node_modules/tsx/dist/loader.mjs backend/server.ts --ui",
    "backup": "node --import ./backend/node_modules/tsx/dist/loader.mjs backend/backup.ts",
    "dev:ui": "vite",
    "dev:api": "node --import ./backend/node_modules/tsx/dist/loader.mjs backend/server.ts",
    "typecheck": "tsc -b && node backend/node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit",
    "test": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test backend/tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "2.4.0",
    "@tiptap/extension-highlight": "2.4.0",
    "@tiptap/pm": "2.4.0",
    "@tiptap/react": "2.4.0",
    "@tldraw/assets": "5.5.2",
    "@tldraw/tldraw": "^5.5.2",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
